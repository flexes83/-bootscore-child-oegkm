{
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1380px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#0B6668"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#47D7B0"
        },
        {
          "slug": "accent-soft",
          "name": "Accent Soft",
          "color": "#DFF4E9"
        },
        {
          "slug": "mint",
          "name": "Mint",
          "color": "#EEF7EE"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "#1F2F39"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "headline",
          "fontFamily": "Chillax, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "Chillax"
        },
        {
          "slug": "body",
          "fontFamily": "DM Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "DM Sans"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.95rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2.5rem",
          "name": "XL"
        },
        {
          "slug": "xx-large",
          "size": "4.5rem",
          "name": "XXL"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--text)",
      "background": "var(--wp--preset--color--white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.55"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)",
          "lineHeight": "1.05",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.15rem",
            "bottom": "0.85rem",
            "left": "1.15rem"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontFamily": "var(--wp--preset--font-family--headline)"
        }
      }
    }
  }
}